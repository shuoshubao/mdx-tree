{
  "name": "mdx-tree",
  "version": "0.3.6",
  "description": "Visually view your local markdown file system on the webpage.",
  "repository": {
    "url": "https://github.com/shuoshubao/mdx-tree.git",
    "type": "git"
  },
  "author": "shuoshubao <759979885@qq.com>",
  "type": "module",
  "bin": {
    "mdx-tree": "index.js"
  },
  "files": [
    "dist",
    "index.js"
  ],
  "keywords": [
    "mdx-tree"
  ],
  "scripts": {
    "start": "esbuild lib/index.jsx  --outdir=dist --bundle --jsx=automatic --watch",
    "build": "esbuild lib/index.jsx --outdir=dist --bundle --jsx=automatic --minify",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "chalk": "^6.0.1",
    "glob": "^14.0.3",
    "koa": "^3.3.0",
    "mime-types": "^3.0.2",
    "portfinder": "^1.0.32",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "antd": "^5.1.1",
    "esbuild": "^0.28.2",
    "filesize": "^11.0.29",
    "highlight.js": "^11.7.0",
    "lodash-es": "^4.17.21",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-attrs": "^5.0.1",
    "markdown-it-task-lists": "^2.1.1",
    "mdx-toc": "^1.2.0",
    "prettier": "^3.9.10",
    "re-resizable": "^6.9.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
